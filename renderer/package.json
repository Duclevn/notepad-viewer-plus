{
  "name": "markdown-preview-plus-renderer",
  "version": "0.1.5",
  "private": true,
  "description": "Offline Markdown renderer used by the Markdown Preview Plus Notepad++ plugin",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "size": "node ../packaging/check-size.mjs dist",
    "size:strict": "node ../packaging/check-size.mjs dist --strict",
    "licenses": "node ../packaging/generate-licenses.mjs"
  },
  "dependencies": {
    "@mermaid-js/tiny": "12.0.0",
    "@plantuml/core": "1.2026.8",
    "dompurify": "3.4.16",
    "highlight.js": "11.12.0",
    "js-yaml": "4.1.1",
    "katex": "0.18.9",
    "markdown-it": "15.0.2",
    "markdown-it-container": "4.0.0"
  },
  "devDependencies": {
    "@types/dompurify": "3.2.0",
    "@types/js-yaml": "4.0.9",
    "@types/markdown-it": "14.1.2",
    "@types/node": "22.15.21",
    "jsdom": "26.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
